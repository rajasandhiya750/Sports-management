<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Admhome.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head runat="server">
    <title></title>
    <link href="~/Styles/Site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .style2
        {
            text-align: center;
        }
        .style3
        {
            width: 0;
            height: 0;
        }
        .style4
        {
            width: 256px;
            height: 256px;
        }
    </style>
</head>
<body>
    <form runat="server">
    <div class="page">
        <div class="header">
            <div class="title">
                <h1 class="style2">
                    WELCOME ADMIN</h1>
                <p>
                    <img alt="XS" class="style3" src="images/vector-users-icon.jpg" /><img alt="CD" 
                        class="style4" src="images/admin.png" /></p>
            </div>
            <div class="loginDisplay">
            </div>
            <div class="clear hideSkiplink">
                <asp:Menu ID="NavigationMenu" runat="server" CssClass="menu" EnableViewState="false" IncludeStyleBlock="false" Orientation="Horizontal">
                    <Items>
                        <asp:MenuItem NavigateUrl="~/AdmHome.aspx" Text="Home"/>
                        <asp:MenuItem NavigateUrl="~/adstudent.aspx" Text="AddStudent" 
                            Value="AddStudent"/>
                        <asp:MenuItem NavigateUrl="~/addequip.aspx" Text="AddEquipment" 
                            Value="AddEquipment">
                        </asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/AddTeams.aspx" Text="AddTeams" Value="AddTeams">
                        </asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/addtournament.aspx" Text="AddTournament" 
                            Value="AddTournament">
                        </asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/addperformance.aspx" Text="AddPerformance" 
                            Value="AddPerformance"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/cradmuser.aspx" Text="CreateUser" 
                            Value="CreateUser"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/deladmuser.aspx" Text="DeleteUSer" 
                            Value="DeleteUSer"></asp:MenuItem>
                        <asp:MenuItem Text="Reports" Value="ViewEquipments">
                        </asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/login.aspx" Text="Logout" Value="Logout">
                        </asp:MenuItem>
                    </Items>
                </asp:Menu>
            </div>
        </div>
        <div class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"/>
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="footer">
        
    </div>
    </form>
</body>
</html>
